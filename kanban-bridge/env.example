# Copy to ~/.config/kanban-bridge/env (chmod 600, dir 700).
# Quote any value containing '&' in single quotes.

# Required secrets (generate WEBHOOK_SECRET with `openssl rand -hex 24`)
WEBHOOK_SECRET=
PLANKA_API_KEY=
PLANKA_BOT_API_KEY=

# Provider selection (pluggable via providers/__init__.py)
BRIDGE_BOARD_PROVIDER=planka
BRIDGE_AGENT_PROVIDER=agy           # 'agy', 'claude', or 'opencode'

# Planka endpoints
PLANKA_URL=http://localhost:3000
PLANKA_WEBHOOK_URL=http://127.0.0.1:8787/planka

# Trigger, bot, and column configuration
BRIDGE_TRIGGER_LABEL=agy            # e.g. 'agy', 'claude', or 'opencode'
BOT_USERNAME=agy                    # e.g. 'agy', 'claude', or 'opencode'
BRIDGE_BACKLOG_BUCKET=backlog       # cards in Backlog stay parked (ignored) until moved out
BRIDGE_PENDING_BUCKET=pending       # finished runs & clean audits land here (never auto-Done)
BRIDGE_AUDIT_BUCKET=auditing

# Desktop notifications ('auto' uses Linux notify-send when installed; 'off' disables — e.g. with SwiftBar on macOS)
BRIDGE_NOTIFY=auto

# --- Claude Code provider settings (when BRIDGE_AGENT_PROVIDER=claude) ---
# BRIDGE_CLAUDE_MODE=docker         # 'docker' (isolated container + auth proxy) or 'host'
# CLAUDE_OAUTH_TOKEN=               # from `claude setup-token` (required for docker mode)
# BRIDGE_AGENT_IMAGE=kanban-agent:latest
# BRIDGE_PROXY_PORT=8788
# BRIDGE_DOCKER_NET=host            # 'host' (Linux/rootless) or 'bridge' (macOS/Docker Desktop)
# BRIDGE_DOCKER_USER=0:0            # optional: maps to host UID 1000 on Linux rootless Docker
# BRIDGE_MAX_TURNS=100
# BRIDGE_CLAUDE_MODEL=
# CLAUDE_BIN=~/.local/bin/claude

# --- OpenCode provider settings (when BRIDGE_AGENT_PROVIDER=opencode, native OpenRouter) ---
# OPENROUTER_API_KEY=               # OpenRouter API key (passed to opencode; bridge secrets stay stripped)
# BRIDGE_OPENCODE_MODEL=openrouter/anthropic/claude-haiku-5.5  # default for regular runs (comma-separated fallback list supported)
# BRIDGE_OPENCODE_AGENT=            # optional --agent name
# BRIDGE_OPENCODE_BIN=opencode
# BRIDGE_WORKER_MODEL=openrouter/mistralai/devstral-2512        # built-in subagents (general/explore)

# Dynamic repo discovery: clone repos the bridge should work on into kanban-bridge/repos/
# (keeps your personal ~/workspace untouched; optional BRIDGE_REPOS for extra paths)
BRIDGE_REPOS_ROOT=~/workspace/kanban-bridge/repos
# BRIDGE_REPOS=extra=/path/to/other-repo
BRIDGE_SHARE_CARGO_TARGET=1

# Timeout & concurrency (3600s = 60m for multi-phase builds / swarm + Reviewer Gate)
BRIDGE_RUN_TIMEOUT=3600
BRIDGE_MAX_CONCURRENT=2

# Optional tuning
# BRIDGE_PORT=8787
# BRIDGE_TASKS_ROOT=~/workspace/kanban-tasks
# BRIDGE_AGY_MODEL=
# BRIDGE_AGY_EFFORT=
# BRIDGE_AUDITOR_MODEL=             # e.g. openrouter/z-ai/glm-5.3
# BRIDGE_ORCHESTRATOR_MODEL=        # defaults to 'gemini-pro-orchestrator-neon' on agy; unset on claude/opencode unless set
# BRIDGE_ORCHESTRATOR_LABEL=orchestrator
# BRIDGE_AGY_DISABLE_SLASH_COMMANDS=0
# BRIDGE_AWS_READONLY_PROFILES=profile1,profile2
# Pricing estimates pull from OpenRouter's /api/v1/models with a 6-hour local cache.
# BRIDGE_PRICING_CACHE_TTL=21600
# Optional custom USD per 1M tokens overrides: '{"model-name": [input, output, cache_read, cache_write]}'
# BRIDGE_MODEL_PRICING=
